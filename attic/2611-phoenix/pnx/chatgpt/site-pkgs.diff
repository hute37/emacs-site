+(defun h7/python--percent-notebook-p ()
+  "Return non-nil for Jupytext percent-format files under a notebooks directory."
+  (and buffer-file-name
+       (string-match-p "[/\\\\]notebooks[/\\\\]" buffer-file-name)
+       (save-excursion
+         (goto-char (point-min))
+         (re-search-forward "^[ \t]*#\\s-*%%" (min (point-max) (+ (point-min) 8192)) t))))
+
+(defun h7/python--stop-lsp-clients ()
+  "Detach any Python LSP client currently attached to this buffer."
+  (when (bound-and-true-p lsp-mode)
+    (lsp-mode -1))
+  (when (and (fboundp 'eglot-managed-p) (eglot-managed-p))
+    (eglot-shutdown)))
+
+(defun h7/python--apply-backend (backend)
+  "Apply BACKEND (`lsp' or `eglot') to the current Python buffer."
+  (h7/python--stop-lsp-clients)
+  (setq-local h7/python-lsp-backend backend)
+  (if (eq backend 'eglot)
+      (progn
+        (when (bound-and-true-p flycheck-mode) (flycheck-mode -1))
+        (when (fboundp 'ruff-format-on-save-mode) (ruff-format-on-save-mode -1))
+        (eglot-ensure))
+    (progn
+      (when (fboundp 'flycheck-mode) (flycheck-mode 1))
+      (require 'lsp-pyright)
+      (when-let* ((python (and (fboundp 'pet-executable-find)
+                               (pet-executable-find "python"))))
+        (setq-local lsp-pyright-python-executable-cmd python))
+      (when (require 'ruff-format nil t) (ruff-format-on-save-mode 1))
+      (lsp-deferred))))
+
+(defun h7/python-dispatch-lsp ()
+  "Choose exactly one Python LSP client after local variables are processed."
+  (when (derived-mode-p 'python-base-mode)
+    (let ((backend (or h7/python-lsp-backend
+                       (if (h7/python--percent-notebook-p) 'eglot 'lsp))))
+      (h7/python--apply-backend backend))))
+
+(defun h7/python--install-lsp-dispatcher ()
+  "Install the per-buffer dispatcher after file and directory local variables."
+  (add-hook 'hack-local-variables-hook #'h7/python-dispatch-lsp nil t))
+
